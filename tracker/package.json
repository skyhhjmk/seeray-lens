{
  "name": "@seeray/lens-tracker",
  "version": "0.1.0",
  "description": "Lightweight, privacy-first browser tracker for SeeRay Lens.",
  "type": "module",
  "main": "./dist/index.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,iife --global-name SeeRayLens --dts --minify --sourcemap && npm run size",
    "lint": "eslint src test",
    "test": "vitest run",
    "size": "node scripts/report-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
