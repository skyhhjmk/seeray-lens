{
  "name": "@seeray/lens-tracker",
  "version": "0.9.0",
  "description": "Lightweight, privacy-first browser tracker for SeeRay Lens.",
  "type": "module",
  "main": "./dist/index.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:tracker && npm run build:recorder && npm run build:replayer && npm run size",
    "build:tracker": "tsup src/index.ts --format esm,iife --global-name SeeRayLens --dts --minify --sourcemap",
    "build:recorder": "tsup src/recorder.ts --format esm --minify --sourcemap --out-dir dist",
    "build:replayer": "tsup src/replayer.ts --format esm --minify --sourcemap --out-dir dist",
    "publish:tracker-asset": "node scripts/publish-server-assets.mjs --tracker-only",
    "publish:server-assets": "node scripts/publish-server-assets.mjs",
    "lint": "eslint src test e2e playwright.config.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:heatmap": "playwright test --config=playwright.config.mjs e2e/heatmap-coordinates.pw.mjs",
    "test:e2e:privacy": "playwright test --config=playwright.config.mjs e2e/privacy-preferences.pw.mjs",
    "test:e2e:crash": "playwright test --config=playwright.config.mjs e2e/crash-analytics.pw.mjs",
    "size": "node scripts/report-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "rrweb": "2.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "web-vitals": "6.2.2"
  }
}
